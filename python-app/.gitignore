# Nunca versionar o token nem o ambiente
.env
.venv/
.venv312/
__pycache__/
*.pyc

# Saidas e arquivos de audio (dados clinicos sensiveis - LGPD)
# Organizados por etapa do pipeline: audios/ -> transcricoes/ -> prontuarios/
# As pastas sao versionadas (com .gitkeep); os arquivos dentro nao
audios/*
!audios/.gitkeep
transcricoes/*
!transcricoes/.gitkeep
prontuarios/*
!prontuarios/.gitkeep
# Redundancia caso algum arquivo escape para a raiz
roteiro.txt
prontuario.txt
prontuario.json
*.wav
*.mp3
*.m4a

# Banco de dados local (dados clinicos sensiveis - LGPD)
consultas.db

# Configuracoes locais (segredos e paths de maquina)
settings.local.json
